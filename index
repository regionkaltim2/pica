<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Aplikasi PICA & PRESISI Kaltim2</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            height: 100dvh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #0f172a;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        /* CONTAINER UTAMA */
        .app-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            overflow: hidden;
            background: #0f172a;
        }

        /* IFRAME GOOGLE APPS SCRIPT */
        .gas-frame {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100dvh;
            border: none;
            display: block;
            margin: 0;
            padding: 0;
        }

        /* LOADING SCREEN */
        .loading-screen {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100dvh;
            background: #0f172a;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid rgba(255, 255, 255, 0.12);
            border-left-color: #00d2ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 16px;
        }

        .loading-text {
            font-weight: 600;
            font-size: 14px;
            letter-spacing: 0.5px;
            text-align: center;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>

    <!-- LOADING SCREEN -->
    <div id="loading" class="loading-screen">
        <div class="spinner"></div>
        <p class="loading-text">
            Memuat Portal TAP Untuk Negeri...
        </p>
    </div>

    <!-- APLIKASI GOOGLE APPS SCRIPT -->
    <div class="app-wrapper">
        <iframe
            id="gasFrame"
            class="gas-frame"
            src="https://script.google.com/macros/s/AKfycbyJbifqoVEt-rTaKW6eVyXrCRbHtOgrkd8JoZkq4MXrlxNjcG0G5m6esNFWCrdTaglK3Q/exec"
            allow="geolocation; microphone; camera; clipboard-write"
            scrolling="yes"
            onload="hideLoading()">
        </iframe>
    </div>

    <!-- JAVASCRIPT -->
    <script>
        function hideLoading() {
            const loader = document.getElementById("loading");
            if (!loader) return;

            loader.style.opacity = "0";
            loader.style.visibility = "hidden";

            setTimeout(function () {
                loader.style.display = "none";
            }, 500);
        }

        function resizeApp() {
            const frame = document.getElementById("gasFrame");
            if (!frame) return;
            frame.style.top = "0px";
            frame.style.height = "100dvh";
        }

        window.addEventListener("resize", resizeApp);
        window.addEventListener("orientationchange", function () {
            setTimeout(resizeApp, 300);
        });

        resizeApp();
    </script>
</body>
</html>
